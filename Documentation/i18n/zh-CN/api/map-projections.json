    {
      "id": "WebMercatorProjection.geodeticLatitudeToMercatorAngle",
      "field": "description",
      "sourceHash": "sha256:9b31195beba7b5a6e375368c1bedb3a18341eea7a7ead808c13f6cfdba31cc81",
      "text": "将 -PI/2 至 PI/2 范围内的弧度大地纬度转换为 -PI 至 PI 范围内的墨卡托角。"
    },
    {
      "id": "WebMercatorProjection.geodeticLatitudeToMercatorAngle",
      "field": "params/latitude/description",
      "sourceHash": "sha256:7552184d1a3bd5a6f50cecdbe6173feaa30c3dceb91bf11e40066f6a7051aa10",
      "text": "大地纬度，单位为弧度。"
    },
    {
      "id": "WebMercatorProjection.geodeticLatitudeToMercatorAngle",
      "field": "returns/0/description",
      "sourceHash": "sha256:ea0ccb583d183a9d79b9c8ae57e4dcc8feb8524738689f25a1251fb923be788b",
      "text": "墨卡托角。"
    },
    {
      "id": "WebMercatorProjection.MaximumLatitude",
      "field": "description",
      "sourceHash": "sha256:8d30bbf293f82721beca7b843b83e380ada64493b7e66cad4ff0544a4d865535",
      "text": "Web 墨卡托投影（EPSG:3857）支持的最大纬度，南北对称。理论上墨卡托投影定义到但不包括 90 度；由于随纬度增大而急剧增长，通常更早截断。Google Maps、Bing Maps 和 Esri 使用此截断值，是为了使投影在 X、Y 方向具有相等范围，形成正方形。该常量通过调用 WebMercatorProjection.mercatorAngleToGeodeticLatitude(Math.PI) 计算。"
    },
    {
      "id": "WebMercatorProjection.mercatorAngleToGeodeticLatitude",
      "field": "description",
      "sourceHash": "sha256:c847774440719777fe2b30d08dcf1f0c26c18a719aac981089f87648427dfc35",
      "text": "将 -PI 至 PI 范围内的墨卡托角转换为 -PI/2 至 PI/2 范围内的大地纬度。"
    },
    {
      "id": "WebMercatorProjection.mercatorAngleToGeodeticLatitude",
      "field": "params/mercatorAngle/description",
      "sourceHash": "sha256:4b4836b18c9f1c2486058a580e583a42c36f20f6c2a365dec3a0563112bbb931",
      "text": "要转换的角度。"
    },
    {
      "id": "WebMercatorProjection.mercatorAngleToGeodeticLatitude",
      "field": "returns/0/description",
      "sourceHash": "sha256:7552184d1a3bd5a6f50cecdbe6173feaa30c3dceb91bf11e40066f6a7051aa10",
      "text": "大地纬度，单位为弧度。"
    },
    {
      "id": "WebMercatorProjection",
      "field": "classdesc",
      "sourceHash": "sha256:5cbafe62cc6bca2d905917312aad73808fd4e5f44779f80a4757354bed6d294e",
      "text": "Google Maps、Bing Maps 和大多数 ArcGIS Online 服务使用的 EPSG:3857 地图投影。将 WGS84 经纬度通过球面而非椭球方程转换为墨卡托坐标。"
    },
    {
      "id": "WebMercatorProjection",
      "field": "params/ellipsoid/description",
      "sourceHash": "sha256:d4987f5b4d3b55df0ddb3f54009edf4bc5f1decfcd20d213883232e3abcc7dd4",
      "text": "椭球。"
    },
    {
      "id": "WebMercatorProjection#ellipsoid",
      "field": "description",
      "sourceHash": "sha256:c2cf9f852d326a8bb4f4372ffbb6add3d5d86466688be99f3beaaf020501e57a",
      "text": "获取 {@link Ellipsoid}。"
    },
    {
      "id": "WebMercatorProjection#project",
      "field": "description",
      "sourceHash": "sha256:14001d1897e8b6c842b9ca3282a554bb0f2df761ff8c316946213b369b2dc077",
      "text": "将弧度大地椭球坐标转换为等价的 Web 墨卡托 X、Y、Z 米制坐标，以 {@link Cartesian3} 返回。高度原样复制为 Z。"
    },
    {
      "id": "WebMercatorProjection#project",
      "field": "params/cartographic/description",
      "sourceHash": "sha256:de1560a97ec37852bf1fe3422654f3b8d1ce180e34a50d04938c285b16a45f13",
      "text": "地理坐标，角度使用弧度。"
    },
    {
      "id": "WebMercatorProjection#project",
      "field": "params/result/description",
      "sourceHash": "sha256:67f9a0485964ed1d4a54e260def19e82d98c0ef1d8df552c803392bcb930498e",
      "text": "用于接收结果的实例；为 undefined 时创建新实例。"
    },
    {
      "id": "WebMercatorProjection#project",
      "field": "returns/0/description",
      "sourceHash": "sha256:e5816a653044a46cf2fdb411ead9f1605c691e693497fcf384eee35e84cef299",
      "text": "等价的 Web 墨卡托 X、Y、Z 坐标，单位为米。"
    },
    {
      "id": "WebMercatorProjection#unproject",
      "field": "description",
      "sourceHash": "sha256:6df4d9f809cb22d5f3ce4d6061e82e568d78a158fd99dbd5bb87a524587c8bc0",
      "text": "将以米为单位的 Web 墨卡托 X、Y 坐标转换为包含大地椭球坐标的 {@link Cartographic}。Z 坐标原样复制为高度。"
    },
    {
      "id": "WebMercatorProjection#unproject",
      "field": "params/cartesian/description",
      "sourceHash": "sha256:f914e8e1bcf16e068aa9b8f5381370a1df2aa9c9c592df092edc5e64ac6313c5",
      "text": "要反投影的 Web 墨卡托笛卡尔位置，其高度 z 使用米。"
    },
    {
      "id": "WebMercatorProjection#unproject",
      "field": "params/result/description",
      "sourceHash": "sha256:67f9a0485964ed1d4a54e260def19e82d98c0ef1d8df552c803392bcb930498e",
      "text": "用于接收结果的实例；为 undefined 时创建新实例。"
