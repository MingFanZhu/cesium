      "text": "Spdcf 构造函数的初始化选项。"
    },
    {
      "id": "Spdcf.ConstructorOptions",
      "field": "properties/A/description",
      "sourceHash": "sha256:11223bbb21b410577d340d5588aedaafef9a20dccc18ba558a0d28b347b2fe64",
