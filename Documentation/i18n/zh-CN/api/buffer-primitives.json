    {
      "id": "BufferPrimitiveCollection#vertexCount",
      "field": "description",
      "sourceHash": "sha256:cd8b40699ed58374ee92fde84a62dd5cbc52294ace7d2d7ed29df061c1f7fd0f",
      "text": "集合中的顶点数量，必须小于等于 {@link vertexCountMax}。"
    },
    {
      "id": "BufferPrimitiveCollection#vertexCountMax",
      "field": "description",
      "sourceHash": "sha256:69286268edb0784e3fd32e63e4d244a80c4ebd54a87e5b859fe4b3125fac57a1",
      "text": "集合可容纳的最大顶点数量，必须大于等于 {@link vertexCount}。"
    },
    {
      "id": "BufferPrimitiveCollection",
      "field": "classdesc",
      "sourceHash": "sha256:1b3b723cb683fef95fda25407d15ae2412e1a01aec1374b7ad62bbd2b11bbf77",
      "text": "采用 ArrayBuffer 存储的图元集合，以优化性能和内存。\n<p>若集合包含 N 个图元，为充分发挥性能优势，应避免同时分配 N 个关联 JavaScript 对象。处理大型集合时，可复用 {@link BufferPrimitive}、{@link Color}、{@link Cartesian3} 等对象，采用{@link https://en.wikipedia.org/wiki/Flyweight_pattern|享元模式}。</p>"
    },
    {
      "id": "BufferPrimitiveCollection",
      "field": "params/options.allowPicking/description",
      "sourceHash": "sha256:9ce763ef285c13b875762085c046766a054ebffdc7a7bd643de4592301d030ff",
      "text": "为 <code>true</code> 时，可通过 {@link Scene#pick} 拾取图元；为 <code>false</code> 时可降低内存与初始化开销。"
    },
    {
      "id": "BufferPrimitiveCollection",
      "field": "params/options.boundingVolume/description",
      "sourceHash": "sha256:d6451397396b58cc25178ab6bffa5a9069b8112fbf76ec15dde8b1b9aa6b8a88",
      "text": "集合的世界空间包围体。未指定时，自动计算并在图元位置变化时更新；已指定时，由用户按需更新。大型动态集合可通过预先计算包围体并仅在必要时更新来提高性能。"
    },
    {
      "id": "BufferPrimitiveCollection",
      "field": "params/options.modelMatrix/description",
      "sourceHash": "sha256:dafdae78f13684907f6f9a43b6291a8d915022921f941ea13135302a75c734e9",
      "text": "将几何从模型坐标变换到世界坐标。"
    },
    {
      "id": "BufferPrimitiveCollection",
      "field": "params/options.positionNormalized/description",
      "sourceHash": "sha256:66c4c10161a61283dcb64fc298ee6300e23c71658147b0ac8d6a6af7b5e24f67",
      "text": "为 <code>true</code> 时，将整数位置值归一化，使完整整数范围映射至有符号的 [-1, 1] 或无符号的 [0, 1]。仅对 BYTE、UNSIGNED_BYTE、SHORT、UNSIGNED_SHORT 整数位置数据类型有效。"
    },
    {
      "id": "BufferPrimitiveMaterial.pack",
      "field": "description",
      "sourceHash": "sha256:4b956736771460bc70360de3c8cd58293506a12e7808b01de7f2ed54857c513c",
      "text": "将给定材质按字节偏移写入给定 DataView。"
    },
    {
      "id": "BufferPrimitiveMaterial.unpack",
      "field": "description",
      "sourceHash": "sha256:f64f6ab7857e89f5312af6ba0a32c2959c760104d4c05e933fbe2f622e13a1f6",
      "text": "从已打包的 DataView 中读取材质。"
    },
    {
      "id": "BufferPrimitiveMaterial.unpack",
      "field": "params/byteOffset/description",
      "sourceHash": "sha256:38e5f0af980cb7c60559f1341e3c1b6d87b09b5372da47f80349c45bce191c6d",
      "text": "开始解包的字节偏移。"
    },
    {
      "id": "BufferPrimitiveMaterial.unpack",
      "field": "params/result/description",
      "sourceHash": "sha256:913ed489f7f7352ace87219931860ecd6691d2dfd2ca1553e764f0a0b3f84061",
      "text": "接收解包结果的材质对象。"
    },
    {
      "id": "BufferPrimitiveMaterial.unpack",
      "field": "returns/0/description",
      "sourceHash": "sha256:a54b0f30c2aa731c189258f0859d3be8de1d34d05d1b1b0643a318eda001ed78",
      "text": "接收解包结果后修改的 result 材质。"
    },
    {
      "id": "BufferPrimitiveMaterial#color",
      "field": "description",
      "sourceHash": "sha256:f7f6c0ff79d3408a0ceca0bc3732fc5efaa8c4b7c51b1b4172da2d90635b6624",
      "text": "填充颜色。"
    },
    {
