    },
    {
      "id": "GoogleStreetViewCubeMapPanoramaProvider#loadPanorama",
      "field": "description",
      "sourceHash": "sha256:a1d721ed7927cf0462ac58b4026349d938a21a070125d47c9be51c4790e2a255",
      "text": "获取指定位置和朝向的全景图元。"
    },
    {
      "id": "GoogleStreetViewCubeMapPanoramaProvider#loadPanorama",
