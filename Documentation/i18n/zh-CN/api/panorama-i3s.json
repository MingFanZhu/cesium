    },
    {
      "id": "GoogleStreetViewCubeMapPanoramaProvider#getNearestPanoId",
      "field": "params/radius/description",
      "sourceHash": "sha256:92c65ca7f75be8721fe8f712418d006e3b333f461e6e9958e2d264ee829f187d",
