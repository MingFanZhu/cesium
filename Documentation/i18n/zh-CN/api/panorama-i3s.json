    },
    {
      "id": "GoogleStreetViewCubeMapPanoramaProvider#getPanoIdMetadata",
      "field": "returns/0/description",
      "sourceHash": "sha256:4e4e46103f88759d617b7509b55aab023c59b65c916bd67a60be83c26c511df4",
