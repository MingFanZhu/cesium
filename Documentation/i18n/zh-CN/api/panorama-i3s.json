    {
      "id": "GoogleStreetViewCubeMapPanoramaProvider.fromUrl",
      "field": "description",
      "sourceHash": "sha256:845f94cbed9c97e947f19b88ae48d3cf7cb80b9245f40783d353355a14f4d6a8",
      "text": "创建从 {@link https://developers.google.com/maps/documentation/streetview|Google Street View Static API} 提供立方体各面图像的 {@link PanoramaProvider}。"
    },
    {
      "id": "GoogleStreetViewCubeMapPanoramaProvider.fromUrl",
      "field": "params/options.key/description",
      "sourceHash": "sha256:32cbece098a41bef2d9f2079c4e98bcb41ea379e18ad4c209dbb2976cb684aeb",
      "text": "访问 Google Street View Static API 的 API 密钥，创建方法见 {@link https://developers.google.com/maps/documentation/javascript/get-api-key}。为 undefined 时使用 {@link GoogleMaps.defaultStreetViewStaticApiKey}；该值不可用时，使用 {@link GoogleMaps.defaultApiKey}。"
    },
    {
      "id": "GoogleStreetViewCubeMapPanoramaProvider.fromUrl",
      "field": "params/options.tileSize/description",
      "sourceHash": "sha256:7024ab878e5a55eea6f00f08a4d6df2856dc06030e6f5f99f091d05bd9219fae",
      "text": "每个正方形瓦片默认的宽和高，单位为像素。"
    },
    {
      "id": "GoogleStreetViewCubeMapPanoramaProvider.fromUrl",
