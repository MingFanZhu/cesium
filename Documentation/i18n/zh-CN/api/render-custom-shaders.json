    },
    {
      "id": "CustomShaderTranslucencyMode",
      "field": "properties/TRANSLUCENT/description",
      "sourceHash": "sha256:7336458d380c16cd7cd4f6f8a20aa0555ce93ded557f2b68ee2683d8bb8a7a97",
