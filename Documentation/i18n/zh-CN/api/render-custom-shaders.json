    },
    {
      "id": "LightingModel.PBR",
      "field": "description",
      "sourceHash": "sha256:0870b931b4f15b925c98d16bbc84339b221fbb1bab90553a294c35e1750b7e92",
      "text": "使用基于物理的光照计算，支持 PBR 金属度／粗糙度与 PBR 镜面反射／光泽度流程，并在可用时应用基于图像的光照。"
    },
    {
      "id": "LightingModel.UNLIT",
      "field": "description",
      "sourceHash": "sha256:e3fb33d2143435847d299a22a91fbe56cedb913ed749a7680d814d5e3d067b96",
      "text": "使用无光照着色，即跳过光照计算。计算 <code>out_FragColor</code> 时直接使用模型漫反射颜色，该颜色应为线性 RGB 而非 sRGB。仍会应用 alpha 模式。"
    },
    {
      "id": "LightingModel",
      "field": "description",
      "sourceHash": "sha256:6760827ab0690a2d08310c3eff090e464bea3884f3a1435c8343439570029bad",
      "text": "为 {@link Model} 进行光照计算时使用的光照模型。"
    },
    {
      "id": "LightingModel",
      "field": "properties/PBR/description",
      "sourceHash": "sha256:0870b931b4f15b925c98d16bbc84339b221fbb1bab90553a294c35e1750b7e92",
      "text": "使用基于物理的光照计算，支持 PBR 金属度／粗糙度与 PBR 镜面反射／光泽度流程，并在可用时应用基于图像的光照。"
    },
    {
      "id": "LightingModel",
      "field": "properties/UNLIT/description",
      "sourceHash": "sha256:e3fb33d2143435847d299a22a91fbe56cedb913ed749a7680d814d5e3d067b96",
      "text": "使用无光照着色，即跳过光照计算。计算 <code>out_FragColor</code> 时直接使用模型漫反射颜色，该颜色应为线性 RGB 而非 sRGB。仍会应用 alpha 模式。"
    },
